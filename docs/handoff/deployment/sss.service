[Unit]
Description=SSS ephemeral artifact relay
Documentation=file:/usr/share/doc/sss/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sss
Group=sss
ExecStart=/usr/local/bin/sss serve --config /etc/sss/config.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=45
RuntimeDirectory=sss
RuntimeDirectoryMode=0750
StateDirectory=sss
StateDirectoryMode=0750
UMask=0027
LimitNOFILE=65536

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sss /var/lib/sss /run/sss
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
